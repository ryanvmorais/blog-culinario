# --- 1. PYTHON ---
# Bytecode e artefatos de build recriáveis a qualquer momento.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- 2. AMBIENTE E DEPENDÊNCIAS ---
# Recriável com `uv sync`; o que fixa as versões é o uv.lock, que É commitado.
.venv/
.python-version.local

# --- 3. CACHES DE FERRAMENTA ---
# Cache local de ruff/mypy/pytest — recriado do zero a cada execução.
.ruff_cache/
.mypy_cache/
.pytest_cache/

# --- 4. SAÍDA DE TESTE E COBERTURA ---
# Relatório de cobertura gerado localmente; não faz sentido versionar.
.coverage
htmlcov/

# --- 5. BANCO DE DADOS ---
# SQLite local — cada dev/ambiente recria o próprio com as migrations.
db.sqlite3
db.sqlite3-journal

# --- 6. ARQUIVOS ESTÁTICOS E DE MÍDIA GERADOS ---
# staticfiles/ é saída do collectstatic; media/ são uploads de usuário;
# django_cache/ é o cache em arquivo da limitação de taxa (spec 011).
# .gitkeep mantém a pasta versionada mesmo vazia.
/staticfiles/
/media/*
!/media/.gitkeep
/django_cache/

# --- 7. SEGREDOS E CONFIGURAÇÃO LOCAL ---
# .env carrega SECRET_KEY/credenciais reais, e .env.* cobre as variações
# (.env.local, .env.prod). O .env.example é o modelo versionado: a exceção
# abaixo o traz de volta.
.env
.env.*
!.env.example

# --- 8. EDITOR E SISTEMA OPERACIONAL ---
# Configuração pessoal de editor e arquivos gerados pelo sistema operacional.
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- 9. RELATÓRIOS DO LIGHTHOUSE CI ---
# Relatórios do Lighthouse CI gerados localmente (o CI os guarda como artefato).
.lighthouseci/
