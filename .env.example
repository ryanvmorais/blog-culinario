# 🔐 CONFIGURAÇÃO DE AMBIENTE (.env.example)
# 🎯 Para que serve: lista as variáveis que o projeto lê do ambiente, com o que
#    cada uma faz. Valores de verdade (principalmente os segredos) ficam fora do
#    código, num arquivo .env que só existe no seu computador ou no servidor.
# ⚠️ Como usar: copie este arquivo para ".env" e preencha só o que precisar. Em
#    desenvolvimento, nenhuma variável é obrigatória: o settings/dev.py já roda
#    com valores seguros para uso local. As obrigatórias são as de produção.
# 🛑 O ".env" nunca vai para o GitHub (o .gitignore o bloqueia). Este modelo vai,
#    por isso aqui só há valores vazios ou de exemplo.

# --- 1. SEGURANÇA DO DJANGO ---

# Chave que assina as sessões e o token CSRF. Segredo: quem a tem consegue
# forjar uma sessão de login. Gere uma com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Vazia: o desenvolvimento usa uma chave insegura fixa; a produção não sobe.
DJANGO_SECRET_KEY=

# --- 2. ENDEREÇO DO SITE ---

# Domínios que o site aceita atender, separados por vírgula (espaços e vírgula
# sobrando são ignorados), por exemplo: blog.exemplo.com.br. Público. Só vale em
# produção: em desenvolvimento, o site atende localhost e 127.0.0.1.
# Em produção, ausente, o site não sobe; vazia, recusa todo pedido.
DJANGO_ALLOWED_HOSTS=

# Endereço público do site, só esquema e domínio, por exemplo:
# https://blog.exemplo.com.br. Público. É de onde saem o <link rel="canonical">,
# o og:url, o /sitemap.xml e a linha Sitemap: do /robots.txt; nenhum deles usa o
# Host do pedido, que vem do visitante (spec 010). Com caminho, query ou outro
# esquema, o site não sobe.
# Vazio (padrão): sem canonical, sem og:url, e o /sitemap.xml responde 404.
URL_PUBLICA=

# --- 3. DEMONSTRAÇÃO PÚBLICA ---

# "True" numa demonstração aberta ao público (spec 009): cadastro e comentário
# validam, mas não gravam nada, a tela de login mostra uma conta pública e o
# /.well-known/security.txt passa a existir (spec 010). Público. Com o modo
# ligado, crie a conta pública com:
#   uv run python manage.py criar_conta_demonstracao
# Vazio ou "False" (padrão): tudo grava normalmente.
MODO_DEMONSTRACAO=False

# --- 4. HOSPEDAGEM (spec 011) ---

# Pasta dos dados que o site grava: o banco (db.sqlite3), as capas (media/) e o
# cache da limitação de taxa (django_cache/). Num servidor em contêiner, aponte
# para o volume que sobrevive ao deploy, por exemplo: /data; caminho relativo
# parte da raiz do projeto. Público.
# Vazio (padrão): a raiz do projeto, como em desenvolvimento.
DIRETORIO_DADOS=

# Trava de origem, para quem publica atrás da Cloudflare. Segredo. Gere um com:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# e crie na Cloudflare uma regra de transformação que acrescente a todo pedido
# o cabeçalho X-Origin-Verify com esse valor. Definido, o site responde 403 a
# todo pedido sem o cabeçalho, e a limitação de taxa passa a usar o IP real do
# visitante (CF-Connecting-IP). Por isso, deixe vazio em desenvolvimento.
# Vazio (padrão): trava desligada e IP do REMOTE_ADDR. Atrás de um proxy, isso
# faz todos os visitantes dividirem o mesmo limite de login e de comentário.
ORIGEM_SEGREDO=

# O segredo antigo, só durante a troca: o site aceita os dois até a regra da
# Cloudflare passar a mandar o novo. Segredo.
# Vazio (padrão): só o ORIGEM_SEGREDO vale.
ORIGEM_SEGREDO_ANTERIOR=
