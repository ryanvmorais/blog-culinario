# Copie este arquivo para ".env" (nunca commitado) e ajuste os valores.
# Em desenvolvimento local, nenhuma destas variáveis é obrigatória — o
# settings/dev.py já roda com defaults seguros para uso local.

# Chave de assinatura de sessões/CSRF. Gere uma nova para produção com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# "True" só em desenvolvimento. settings/prod.py ignora esta variável e
# força DEBUG=False sempre.
DJANGO_DEBUG=True

# Lista separada por vírgula. Obrigatório em produção (settings/prod.py
# não tem default). Exemplo para PythonAnywhere: meuusuario.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=

# "True" na instância pública de demonstração (spec 009): cadastro e comentário
# validam, mas não gravam nada, e a tela de login mostra a conta de demonstração.
# O /.well-known/security.txt (contato de segurança do repositório) só existe
# com o modo ligado (spec 010).
# Vazio ou "False" (padrão): tudo grava normalmente. Com o modo ligado, crie a
# conta com: uv run python manage.py criar_conta_demonstracao
MODO_DEMONSTRACAO=False

# Endereço público do site, só esquema e host (spec 010), por exemplo
# https://blog.exemplo.com.br. É a única fonte do <link rel="canonical">, do
# og:url, do /sitemap.xml e da linha Sitemap: do /robots.txt; nenhum deles
# usa o Host do pedido. Vazio (padrão): sem canonical, sem og:url e o
# /sitemap.xml responde 404. Com caminho, query ou outro esquema, o site não sobe.
URL_PUBLICA=
